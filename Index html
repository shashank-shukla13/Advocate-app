<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#f6f3eb">
<title>Advocate - a quiet place to think</title>
<link rel="manifest" href="data:application/manifest+json,{&quot;name&quot;:&quot;Advocate Assistant&quot;,&quot;short_name&quot;:&quot;Advocate&quot;,&quot;start_url&quot;:&quot;/&quot;,&quot;display&quot;:&quot;standalone&quot;,&quot;background_color&quot;:&quot;#f6f3eb&quot;,&quot;theme_color&quot;:&quot;#456b5b&quot;}">
<style>
@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap");

:root {
    --ink: #233d36; --ink-soft: #5d7068; --paper: #f6f3eb; --paper-deep: #ede9dd;
    --sage: #a5b8a5; --sage-pale: #dce5d8; --fern: #456b5b; --fern-deep: #315245;
    --clay: #ba7259; --line: rgba(49, 82, 69, .16);
}

* { box-sizing: border-box; }
html { background: var(--paper); }
body { 
    margin: 0; min-width: 320px; color: var(--ink); background: var(--paper); 
    font-family: "DM Sans", sans-serif; display: flex; flex-direction: column; 
    height: 100vh; overflow: hidden;
}

button { font: inherit; -webkit-tap-highlight-color: transparent; }
button:focus-visible { outline: 3px solid rgba(186,114,89,.42); outline-offset: 3px; }

.app-shell {
    flex: 1; position: relative; overflow-y: auto; display: flex; flex-direction: column;
    background: radial-gradient(circle at 11% 8%, rgba(227,187,113,.2), transparent 22rem),
    radial-gradient(circle at 91% 76%, rgba(165,184,165,.29), transparent 30rem), var(--paper);
}

.topbar { 
    position: relative; z-index: 1; width: min(1180px, calc(100% - 48px)); margin: 0 auto;
    height: 86px; display: flex; align-items: center; justify-content: space-between; 
    border-bottom: 1px solid var(--line); flex-shrink: 0;
}

.brand { 
    display: inline-flex; align-items: center; gap: 11px; padding: 0; 
    color: var(--ink); background: transparent; letter-spacing: -.02em; border: none;
}
.brand-word { font-size: 18px; font-weight: 700; font-family: "Playfair Display", serif; }
.brand-word span { color: var(--clay); font-style: italic; }
.mark { 
    display: grid; place-items: center; width: 30px; height: 30px; flex: 0 0 auto; 
    color: var(--fern-deep); background: rgba(220,229,216,.74); 
    border: 1px solid rgba(49,82,69,.32); border-radius: 12px 5px 12px 5px; transform: rotate(-9deg); 
}
.mark svg { transform: rotate(9deg); width: 16px; height: 16px; }

main {
    position: relative; z-index: 1; width: min(1180px, calc(100% - 48px)); margin: 0 auto;
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 20px 0;
}

#transcript { 
    font-size: 1.2rem; text-align: center; min-height: 60px; color: var(--ink-soft); 
    font-family: "Playfair Display", serif; font-style: italic; margin-bottom: 20px;
}

#verdict-board {
    background: var(--paper-deep); padding: 25px; border-radius: 16px; 
    width: 100%; max-width: 500px; display: none; margin-bottom: 30px;
    border: 1px solid var(--line); box-shadow: 0 10px 30px rgba(35, 61, 54, 0.05);
}

.lens-title {
    font-family: "DM Mono", monospace; font-size: 0.75rem; color: var(--clay);
    text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 20px;
    text-align: center; border-bottom: 1px solid var(--line); padding-bottom: 10px;
}

h4 { margin: 0 0 8px 0; color: var(--fern-deep); font-family: "Playfair Display", serif; font-size: 1.1rem; }
p { margin: 0 0 20px 0; line-height: 1.6; font-size: 0.95rem; }
p:last-child { margin-bottom: 0; }

.mic-btn {
    width: 80px; height: 80px; border-radius: 40px; background-color: var(--fern);
    border: none; color: var(--paper); display: flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 8px 16px rgba(69, 107, 91, 0.2); transition: all 0.2s ease;
}
.mic-btn svg { width: 30px; height: 30px; fill: currentColor; }
.mic-btn.listening {
    background-color: var(--clay); transform: scale(0.95);
    box-shadow: 0 0 0 8px rgba(186, 114, 89, 0.2);
}
</style>
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <div class="brand">
                <div class="mark"><svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 3.8l7.2 14.2H4.8L12 5.8z"/></svg></div>
                <div class="brand-word">Advocate <span>Order</span></div>
            </div>
        </header>

        <main>
            <div id="transcript">Tap to speak your scenario or dilemma...</div>
            
            <div id="verdict-board">
                <div class="lens-title">Second-Order Analysis</div>
                <h4>The Hidden Variable</h4>
                <p id="out-hidden"></p>
                <h4>The Ripple Effect</h4>
                <p id="out-second"></p>
                <h4>The Pivot</h4>
                <p id="out-pivot"></p>
            </div>
            
            <button class="mic-btn" id="micBtn">
                <svg viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5-3c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
            </button>
        </main>
    </div>

    <script>
        const micBtn = document.getElementById('micBtn');
        const transcriptDiv = document.getElementById('transcript');
        const verdictBoard = document.getElementById('verdict-board');
        
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognition = new SpeechRecognition();
        recognition.continuous = false;
        recognition.interimResults = true;
        let isListening = false;

        micBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startListening(); });
        micBtn.addEventListener('touchend', (e) => { e.preventDefault(); stopListening(); });
        micBtn.addEventListener('mousedown', startListening);
        micBtn.addEventListener('mouseup', stopListening);

        function startListening() {
            if (isListening) return;
            recognition.start(); isListening = true;
            micBtn.classList.add('listening');
            transcriptDiv.innerText = "Listening...";
            verdictBoard.style.display = 'none';
        }

        function stopListening() {
            if (!isListening) return;
            recognition.stop(); isListening = false;
            micBtn.classList.remove('listening');
            transcriptDiv.innerText = "Advocate is reflecting...";
        }

        recognition.onresult = (event) => {
            const transcript = Array.from(event.results).map(result => result[0].transcript).join('');
            transcriptDiv.innerText = `"${transcript}"`;
            if (event.results[0].isFinal) sendToGemini(transcript);
        };

        async function sendToGemini(idea) {
            try {
                // ⚠️ IMPORTANT: Paste your actual Google API key below!
                const API_KEY = "AQ.Ab8RN6JRt4vY769vC6OMVsLSR8shY7a041y3y75HLiOcBtiWJQ"; 
                
                const prompt = `You are the 'Second-Order' analytical engine inside the Advocate app. You help humans see past their immediate biases.\nThe user's real-world scenario/plan is: "${idea}"\n\nAnalyze this universally, whether it is a business strategy, personal finance, technical architecture, or daily logistics.\nRespond ONLY in valid JSON format with three exact keys. Keep answers highly insightful, pragmatic, and under 3 sentences each.\n\n{\n  "hidden_variable": "Identify the one critical real-world factor or blindspot the user is likely ignoring.",\n  "second_order": "Predict the most likely 3-to-6 month ripple effect of this action that isn't immediately obvious.",\n  "pivot": "Provide a concrete micro-adjustment or strategy to execute this plan better with lower risk."\n}`;

                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
                });
                
                const data = await response.json();
                if (data.error) throw new Error(data.error.message);

                let rawText = data.candidates[0].content.parts[0].text;
                rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();
                const result = JSON.parse(rawText);
                
                document.getElementById('out-hidden').innerText = result.hidden_variable;
                document.getElementById('out-second').innerText = result.second_order;
                document.getElementById('out-pivot').innerText = result.pivot;
                verdictBoard.style.display = 'block';
                
            } catch (error) {
                transcriptDiv.innerText = "Failed to connect to AI engine. Did you insert your API key?";
            }
        }
    </script>
</body>
</html>
